# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LLM Provider (Chat Completions — OpenAI-compatible)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Provider presets (uncomment to switch):
# OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=openai/gpt-4o-mini
#
# Ollama (local):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
#
# LM Studio (local):
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lm-studio
#   LLM_MODEL=lmstudio-community/Meta-Llama-3.1-8B-Instruct-GGUF

# Embedding Provider (optional — falls back to LLM settings if not set)
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# LangSmith (optional)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=rag-masterclass
LANGSMITH_TRACING=true

# Web Search (Tavily — optional)
TAVILY_API_KEY=

CORS_ORIGINS=http://localhost:5173
